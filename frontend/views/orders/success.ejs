<%
  const formatPrice = (price) => (price ? Number(price).toLocaleString('vi-VN') + 'đ' : '0đ');
  const pmMap = { cod: 'Thanh toán khi nhận hàng (COD)', bank_transfer: 'Chuyển khoản / QR Code', momo: 'Ví MoMo' };
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đặt hàng thành công | Fashion Store</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/shopee.css?v=6">
  <style>
    .success-page {
      max-width: 760px; margin: 0 auto;
      padding: 40px 15px 80px;
      padding-top: 40px;
      margin-top: 20px;
      font-family: 'Inter', sans-serif;
      text-align: center;
    }
    .success-icon-wrap {
      width: 110px; height: 110px; margin: 0 auto 24px;
      background: linear-gradient(135deg, #10b981, #059669);
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 12px 28px rgba(16,185,129,0.3);
      animation: bounceIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .success-icon-wrap i { font-size: 3rem; color: #fff; }
    
    .success-title {
      font-family: 'Playfair Display', serif;
      font-size: 2.6rem; color: #2c2c2c; margin-bottom: 8px;
    }
    .success-subtitle {
      font-size: 1.05rem; color: #6c757d; margin-bottom: 32px;
    }

    .success-card {
      background: #fff; border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.06);
      padding: 30px; text-align: left; margin-bottom: 24px;
      border: 1px solid #f0f0f0;
      animation: slideUp 0.5s ease 0.1s both;
    }
    .success-card-header {
      display: flex; justify-content: space-between; align-items: center;
      padding-bottom: 16px; border-bottom: 1px solid #f0e6db;
      margin-bottom: 20px;
    }
    .success-card-header .lbl { font-size: 0.95rem; color: #888; font-weight: 500; }
    .success-card-header .val { font-size: 1.2rem; font-weight: 700; color: #d4a574; letter-spacing: 0.5px; }

    .order-info-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
    }
    .info-item .lbl { display: block; font-size: 0.85rem; color: #888; margin-bottom: 4px; }
    .info-item .val { display: block; font-size: 0.95rem; color: #333; font-weight: 600; line-height: 1.4; }

    .payment-instruction {
      border-radius: 12px; padding: 20px; text-align: left; margin-bottom: 24px;
      animation: slideUp 0.5s ease 0.2s both;
    }
    .payment-instruction h4 { margin-bottom: 12px; font-size: 1.05rem; display: flex; align-items: center; gap: 8px; }
    .payment-instruction p { margin-bottom: 6px; font-size: 0.95rem; color: #444; }
    .payment-instruction p:last-child { margin-bottom: 0; }
    
    .pi-bank { background: #f0fdf4; border: 1px solid #bbf7d0; }
    .pi-bank h4 { color: #166534; }
    .pi-momo { background: #fdf2f8; border: 1px solid #fbcfe8; }
    .pi-momo h4 { color: #9d174d; }

    .items-list {
      margin-top: 24px; border-top: 1px solid #f0f0f0; padding-top: 24px;
    }
    .items-list h3 { font-size: 1.1rem; color: #333; margin-bottom: 16px; }
    .oi-row {
      display: flex; align-items: center; gap: 16px;
      padding: 12px 0; border-bottom: 1px dashed #eee;
    }
    .oi-img { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; border: 1px solid #f0f0f0; }
    .oi-info { flex: 1; }
    .oi-name { font-size: 0.95rem; font-weight: 600; color: #333; margin-bottom: 4px; }
    .oi-qty { font-size: 0.85rem; color: #888; }
    .oi-price { font-weight: 600; color: #555; }

    .order-total-row {
      display: flex; justify-content: space-between; align-items: center;
      padding-top: 20px; margin-top: 12px;
    }
    .order-total-row span { font-size: 1.1rem; font-weight: 600; color: #333; }
    .order-total-row .total-val { font-size: 1.6rem; font-weight: 800; color: #d4a574; }

    .action-buttons {
      display: flex; gap: 16px; justify-content: center; margin-top: 32px;
      animation: slideUp 0.5s ease 0.3s both;
    }
    .btn-action {
      padding: 14px 28px; border-radius: 8px; font-weight: 600; font-size: 0.95rem;
      text-decoration: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-view { background: #fff; border: 1px solid #ddd; color: #555; }
    .btn-view:hover { border-color: #d4a574; color: #d4a574; background: #fef9f4; }
    .btn-shop { background: linear-gradient(135deg, #d4a574, #c49565); border: none; color: #fff; box-shadow: 0 4px 12px rgba(212,165,116,0.3); }
    .btn-shop:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(212,165,116,0.4); }

    @keyframes bounceIn {
      0% { transform: scale(0.3); opacity: 0; }
      50% { transform: scale(1.05); opacity: 1; }
      70% { transform: scale(0.9); }
      100% { transform: scale(1); }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    @media (max-width: 640px) {
      .order-info-grid { grid-template-columns: 1fr; gap: 16px; }
      .action-buttons { flex-direction: column; }
      .btn-action { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>
<%- include('../partials/navbar') %>

<div class="success-page">
  <div class="success-icon-wrap">
    <i class="fas fa-check"></i>
  </div>
  
  <h1 class="success-title">Đặt Hàng Thành Công!</h1>
  <p class="success-subtitle">Cảm ơn bạn đã tin tưởng và mua sắm tại Fashion Store.</p>

  <div class="success-card">
    <div class="success-card-header">
      <span class="lbl">Mã đơn hàng</span>
      <span class="val">#<%= order.OrderNumber %></span>
    </div>
    
    <div class="order-info-grid">
      <div class="info-item">
        <span class="lbl">Người nhận</span>
        <span class="val"><%= order.FullName %></span>
      </div>
      <div class="info-item">
        <span class="lbl">Số điện thoại</span>
        <span class="val"><%= order.Phone %></span>
      </div>
      <div class="info-item">
        <span class="lbl">Địa chỉ giao hàng</span>
        <span class="val"><%= order.Street %><%= order.District ? ', ' + order.District : '' %>, <%= order.City %></span>
      </div>
      <div class="info-item">
        <span class="lbl">Phương thức thanh toán</span>
        <span class="val"><%= pmMap[order.PaymentMethod] || order.PaymentMethod %></span>
      </div>
    </div>

    <div class="items-list">
      <h3>Sản phẩm đã đặt</h3>
      <% order.items.forEach(item => { %>
        <div class="oi-row">
          <img src="<%= item.Image || '/images/product-default.jpg' %>" alt="<%= item.Name %>" class="oi-img">
          <div class="oi-info">
            <div class="oi-name"><%= item.Name %></div>
            <div class="oi-qty">Số lượng: <%= item.Quantity %></div>
          </div>
          <div class="oi-price"><%= formatPrice(item.price * item.Quantity) %></div>
        </div>
      <% }); %>
      
      <div class="order-total-row">
        <span>Tổng thanh toán</span>
        <span class="total-val"><%= formatPrice(order.totalPrice) %></span>
      </div>
    </div>
  </div>

  <% if (order.PaymentMethod === 'bank_transfer') { %>
    <div class="payment-instruction pi-bank">
      <h4><i class="fas fa-building-columns"></i> Thông tin chuyển khoản Ngân hàng</h4>
      <p>Ngân hàng: <strong>Vietcombank</strong></p>
      <p>Số tài khoản: <strong>1234 5678 9012</strong> – Chủ TK: <strong>FASHION STORE</strong></p>
      <p>Nội dung chuyển khoản: <strong>FS<%= order.OrderNumber %></strong></p>
    </div>
  <% } else if (order.PaymentMethod === 'momo') { %>
    <div class="payment-instruction pi-momo">
      <h4><i class="fas fa-wallet"></i> Thông tin thanh toán Ví MoMo</h4>
      <p>Số điện thoại MoMo: <strong>0901 234 567</strong></p>
      <p>Chủ tài khoản: <strong>FASHION STORE</strong></p>
      <p>Lời nhắn: <strong>FS<%= order.OrderNumber %></strong></p>
    </div>
  <% } %>

  <div class="action-buttons">
    <a href="/orders/<%= order.Id %>" class="btn-action btn-view"><i class="fas fa-file-invoice"></i> Xem chi tiết đơn hàng</a>
    <a href="/products" class="btn-action btn-shop"><i class="fas fa-shopping-bag"></i> Tiếp tục mua sắm</a>
  </div>
</div>

<%- include('../partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
