<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Admin Fashion</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .form-page-layout {
      max-width: 1160px;
      margin: 0 auto;
      padding: 24px;
    }
    .form-top-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 16px;
    }
    .form-page-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.8rem;
      color: #1e293b;
      margin: 0;
    }
    .btn-back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      background: #fff;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      color: #475569;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: all 0.2s;
    }
    .btn-back-link:hover {
      background: #f8fafc;
      border-color: #94a3b8;
      color: #0f172a;
    }

    /* 2 Column Layout */
    .product-form-grid {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 24px;
      align-items: start;
    }

    /* Form Cards */
    .form-card {
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.04);
      padding: 24px;
      margin-bottom: 24px;
      border: 1px solid #f1f5f9;
    }
    .form-card-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: #1e293b;
      margin: 0 0 18px 0;
      display: flex;
      align-items: center;
      gap: 10px;
      padding-bottom: 12px;
      border-bottom: 1px solid #f1f5f9;
    }
    .form-card-title i {
      color: #d4a574;
    }

    /* Inputs */
    .field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 16px;
    }
    .field-group.no-mb { margin-bottom: 0; }
    .field-label {
      font-size: 0.88rem;
      font-weight: 600;
      color: #334155;
    }
    .field-req {
      color: #ef4444;
    }
    .form-input-styled, .form-select-styled, .form-textarea-styled {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 0.92rem;
      font-family: 'Inter', sans-serif;
      outline: none;
      transition: all 0.2s;
      box-sizing: border-box;
      background: #fff;
    }
    .form-input-styled:focus, .form-select-styled:focus, .form-textarea-styled:focus {
      border-color: #d4a574;
      box-shadow: 0 0 0 3px rgba(212,165,116,0.15);
    }
    .form-textarea-styled {
      resize: vertical;
      min-height: 110px;
      line-height: 1.5;
    }
    .field-hint {
      font-size: 0.8rem;
      color: #94a3b8;
    }

    /* Pricing & Discount Calculator */
    .pricing-calc-box {
      background: linear-gradient(135deg, #fefbf6, #fbf4eb);
      border: 1px solid #f2e2ce;
      border-radius: 10px;
      padding: 16px;
      margin-top: 14px;
    }
    .calc-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      font-size: 0.9rem;
    }
    .calc-row:last-child { margin-bottom: 0; }
    .calc-label { color: #64748b; }
    .calc-val-discount {
      font-weight: 700;
      color: #dc2626;
      font-size: 1.05rem;
    }
    .calc-val-saving {
      font-weight: 600;
      color: #d4a574;
    }
    .quick-discount-btns {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px dashed #e7cfb5;
    }
    .btn-quick-pct {
      padding: 4px 10px;
      background: #fff;
      border: 1px solid #d4a574;
      border-radius: 6px;
      font-size: 0.78rem;
      font-weight: 600;
      color: #b45309;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-quick-pct:hover {
      background: #d4a574;
      color: #fff;
    }
    .btn-quick-clear {
      padding: 4px 8px;
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 0.78rem;
      color: #64748b;
      cursor: pointer;
    }
    .btn-quick-clear:hover {
      background: #fee2e2;
      color: #b91c1c;
      border-color: #fca5a5;
    }

    /* Upload Zone */
    .upload-zone-modern {
      border: 2px dashed #cbd5e1;
      border-radius: 10px;
      padding: 28px 20px;
      text-align: center;
      cursor: pointer;
      background: #f8fafc;
      transition: all 0.2s;
    }
    .upload-zone-modern:hover {
      border-color: #d4a574;
      background: #fefcf9;
    }
    .upload-zone-modern i {
      font-size: 2.2rem;
      color: #94a3b8;
      margin-bottom: 10px;
    }
    .upload-zone-modern p {
      margin: 0 0 4px 0;
      font-size: 0.95rem;
      font-weight: 600;
      color: #334155;
    }
    .upload-zone-modern small {
      color: #94a3b8;
      font-size: 0.8rem;
    }
    .images-preview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
      gap: 12px;
      margin-top: 14px;
    }
    .preview-box-item {
      aspect-ratio: 1;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #e2e8f0;
      position: relative;
    }
    .preview-box-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Switch Checkboxes */
    .toggle-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .toggle-item-box {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border-radius: 8px;
      background: #f8fafc;
      border: 1px solid #f1f5f9;
      cursor: pointer;
    }
    .toggle-item-box input {
      width: 18px;
      height: 18px;
      accent-color: #d4a574;
      cursor: pointer;
    }
    .toggle-item-info strong {
      display: block;
      font-size: 0.9rem;
      color: #1e293b;
    }
    .toggle-item-info span {
      font-size: 0.8rem;
      color: #64748b;
    }

    /* Action Buttons */
    .form-bottom-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 24px;
    }
    .btn-form-cancel {
      padding: 12px 24px;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: #fff;
      color: #475569;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95rem;
      transition: all 0.2s;
    }
    .btn-form-cancel:hover {
      background: #f1f5f9;
      color: #0f172a;
    }
    .btn-form-save {
      padding: 12px 28px;
      border-radius: 8px;
      border: none;
      background: linear-gradient(135deg, #d4a574, #c49565);
      color: #fff;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(212,165,116,0.3);
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-form-save:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(212,165,116,0.4);
    }

    @media (max-width: 900px) {
      .product-form-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body class="admin-body">
<%- include('../partials/admin-sidebar') %>

<div class="admin-main">
  <div class="admin-topbar">
    <button class="sidebar-toggle" onclick="toggleSidebar()"><i class="fas fa-bars"></i></button>
    <div style="font-size: 1.1rem; font-weight: 600; color: #1e293b;">
      <i class="fas fa-edit" style="color:#d4a574; margin-right:6px;"></i> <%= title %>
    </div>
    <div class="topbar-right">
      <span class="admin-user"><i class="fas fa-user-circle"></i> <%= user?.Name || 'Admin Fashion' %></span>
    </div>
  </div>

  <div class="form-page-layout">
    <% if (typeof success !== 'undefined' && success && success.length) { %>
      <div class="flash flash-success"><i class="fas fa-check-circle"></i> <%= success[0] %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length) { %>
      <div class="flash flash-error"><i class="fas fa-exclamation-circle"></i> <%= error[0] %></div>
    <% } %>

    <div class="form-top-nav">
      <div>
        <h1 class="form-page-title"><%= product ? 'Chỉnh Sửa Sản Phẩm' : 'Thêm Sản Phẩm Mới' %></h1>
        <p style="color:#64748b; margin:4px 0 0; font-size:0.9rem;">
          <%= product ? 'Mã sản phẩm: #' + product.Id : 'Điền đầy đủ thông tin để tạo sản phẩm mới' %>
        </p>
      </div>
      <a href="/admin/products" class="btn-back-link">
        <i class="fas fa-arrow-left"></i> Quay lại danh sách
      </a>
    </div>

    <form action="<%= product ? '/admin/products/' + product.Id : '/admin/products' %>"
          method="POST" enctype="multipart/form-data">

      <div class="product-form-grid">
        <!-- Left: Main Information -->
        <div class="form-left-col">
          
          <!-- Basic Info -->
          <div class="form-card">
            <div class="form-card-title">
              <i class="fas fa-info-circle"></i> Thông Tin Chung
            </div>

            <div class="field-group">
              <label class="field-label">Tên sản phẩm <span class="field-req">*</span></label>
              <input type="text" name="name" class="form-input-styled" value="<%= product?.Name || '' %>" required placeholder="Ví dụ: Áo Khoác Bomber Nam (Bản cao cấp)">
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:16px;">
              <div class="field-group">
                <label class="field-label">Danh mục <span class="field-req">*</span></label>
                <select name="categoryId" class="form-select-styled" required>
                  <option value="">-- Chọn danh mục --</option>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.Id %>" <%= product?.CategoryId?.toString()===cat.Id.toString()?'selected':'' %>>
                      <%= cat.Name %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <div class="field-group">
                <label class="field-label">Giới tính <span class="field-req">*</span></label>
                <select name="gender" class="form-select-styled" required>
                  <option value="">-- Chọn giới tính --</option>
                  <option value="male" <%= product?.Gender==='male'?'selected':'' %>>Nam</option>
                  <option value="female" <%= product?.Gender==='female'?'selected':'' %>>Nữ</option>
                  <option value="unisex" <%= product?.Gender==='unisex'?'selected':'' %>>Unisex</option>
                </select>
              </div>
            </div>

            <div class="field-group">
              <label class="field-label">Thương hiệu</label>
              <input type="text" name="brand" class="form-input-styled" value="<%= product?.Brand || 'Fashion Store' %>" placeholder="Thương hiệu sản phẩm">
            </div>

            <div class="field-group no-mb">
              <label class="field-label">Mô tả sản phẩm <span class="field-req">*</span></label>
              <textarea name="description" class="form-textarea-styled" required placeholder="Nhập mô tả chi tiết chất liệu, form dáng, xuất xứ..."><%= product?.Description || '' %></textarea>
            </div>
          </div>

          <!-- Product Media -->
          <div class="form-card">
            <div class="form-card-title">
              <i class="fas fa-images"></i> Hình Ảnh Sản Phẩm
            </div>

            <div class="upload-zone-modern" onclick="document.getElementById('imageInput').click()">
              <i class="fas fa-cloud-upload-alt"></i>
              <p>Nhấp vào đây để tải ảnh lên</p>
              <small>Hỗ trợ định dạng JPG, PNG, WebP (Tối đa 5 ảnh)</small>
            </div>
            <input type="file" id="imageInput" name="images" multiple accept="image/*" style="display:none" onchange="previewImages(this)">

            <div style="margin-top:16px;">
              <label class="field-label">Hoặc nhập đường dẫn URL ảnh (mỗi dòng một link)</label>
              <textarea name="imageUrls" class="form-textarea-styled" style="min-height:75px;" placeholder="https://images.unsplash.com/..."><%= product ? (function(){ try { return JSON.parse(product.Images || '[]').join('\n'); } catch(e) { return ''; } })() : '' %></textarea>
            </div>

            <div class="images-preview-grid" id="imagePreview">
              <% if (product && product.Images) { %>
                <% (function(){ try { return JSON.parse(product.Images || '[]'); } catch(e) { return []; } })().forEach(img => { %>
                  <div class="preview-box-item"><img src="<%= img %>" alt="Ảnh sản phẩm" onerror="this.src='/images/product-default.jpg'"></div>
                <% }); %>
              <% } %>
            </div>
          </div>

        </div>

        <!-- Right: Pricing, Status & Organization -->
        <div class="form-right-col">
          
          <!-- Pricing & Live Discount Calculator -->
          <div class="form-card">
            <div class="form-card-title">
              <i class="fas fa-tag"></i> Giá & Khuyến Mãi
            </div>

            <div class="field-group">
              <label class="field-label">Giá gốc (đ) <span class="field-req">*</span></label>
              <input type="number" id="inputPrice" name="price" class="form-input-styled" value="<%= product?.Price || '' %>" required min="0" placeholder="VD: 850000" oninput="calculateDiscount()">
            </div>

            <div class="field-group">
              <label class="field-label">Giá khuyến mãi (đ)</label>
              <input type="number" id="inputSalePrice" name="salePrice" class="form-input-styled" value="<%= product?.SalePrice || '' %>" min="0" placeholder="VD: 720000" oninput="calculateDiscount()">
              <span class="field-hint">Để trống nếu bán theo giá gốc</span>
            </div>

            <!-- Real-time Discount Display -->
            <div class="pricing-calc-box">
              <div class="calc-row">
                <span class="calc-label">Tỷ lệ giảm giá:</span>
                <span class="calc-val-discount" id="dispDiscountPct">-0%</span>
              </div>
              <div class="calc-row">
                <span class="calc-label">Số tiền tiết kiệm:</span>
                <span class="calc-val-saving" id="dispDiscountAmount">0đ</span>
              </div>
              
              <div class="quick-discount-btns">
                <span style="font-size:0.75rem; color:#888; width:100%; margin-bottom:2px;">Chọn nhanh % giảm:</span>
                <button type="button" class="btn-quick-pct" onclick="applyQuickPct(10)">-10%</button>
                <button type="button" class="btn-quick-pct" onclick="applyQuickPct(15)">-15%</button>
                <button type="button" class="btn-quick-pct" onclick="applyQuickPct(20)">-20%</button>
                <button type="button" class="btn-quick-pct" onclick="applyQuickPct(30)">-30%</button>
                <button type="button" class="btn-quick-pct" onclick="applyQuickPct(50)">-50%</button>
                <button type="button" class="btn-quick-clear" onclick="clearDiscount()">Hủy giảm</button>
              </div>
            </div>
          </div>

          <!-- Status & Tags -->
          <div class="form-card">
            <div class="form-card-title">
              <i class="fas fa-sliders-h"></i> Cài Đặt Hiển Thị
            </div>

            <div class="toggle-list">
              <label class="toggle-item-box">
                <input type="checkbox" name="isActive" <%= (product && product.IsActive === false) ? '' : 'checked' %>>
                <div class="toggle-item-info">
                  <strong>Hiển thị trên website</strong>
                  <span>Cho phép khách hàng xem và mua</span>
                </div>
              </label>

              <label class="toggle-item-box">
                <input type="checkbox" name="isFeatured" <%= product?.IsFeatured ? 'checked' : '' %>>
                <div class="toggle-item-info">
                  <strong>Sản phẩm nổi bật</strong>
                  <span>Hiển thị trên trang chủ</span>
                </div>
              </label>

              <label class="toggle-item-box">
                <input type="checkbox" name="isNewArrival" <%= product?.IsNewArrival ? 'checked' : '' %>>
                <div class="toggle-item-info">
                  <strong>Hàng mới về</strong>
                  <span>Gắn nhãn "Mới"</span>
                </div>
              </label>
            </div>

            <div class="field-group" style="margin-top:16px;">
              <label class="field-label">Tags (cách nhau dấu phẩy)</label>
              <input type="text" name="tags" class="form-input-styled" value="<%= product?.Tags || '' %>" placeholder="áo, cotton, cao cấp, hè">
            </div>
          </div>

          <!-- Submit Buttons -->
          <div class="form-bottom-actions">
            <a href="/admin/products" class="btn-form-cancel">Hủy</a>
            <button type="submit" class="btn-form-save">
              <i class="fas fa-save"></i> <%= product ? 'Lưu Thay Đổi' : 'Thêm Sản Phẩm' %>
            </button>
          </div>

        </div>
      </div>

    </form>
  </div>
</div>

<script>
function formatVND(n) {
  return Number(n).toLocaleString('vi-VN') + 'đ';
}

function calculateDiscount() {
  const price = parseFloat(document.getElementById('inputPrice').value) || 0;
  const salePrice = parseFloat(document.getElementById('inputSalePrice').value) || 0;
  const dispPct = document.getElementById('dispDiscountPct');
  const dispAmt = document.getElementById('dispDiscountAmount');

  if (price > 0 && salePrice > 0 && salePrice < price) {
    const diff = price - salePrice;
    const pct = Math.round((diff / price) * 100);
    dispPct.textContent = '-' + pct + '%';
    dispAmt.textContent = formatVND(diff);
  } else {
    dispPct.textContent = '0%';
    dispAmt.textContent = '0đ';
  }
}

function applyQuickPct(pct) {
  const price = parseFloat(document.getElementById('inputPrice').value) || 0;
  if (!price) {
    alert('Vui lòng nhập Giá gốc trước!');
    document.getElementById('inputPrice').focus();
    return;
  }
  const sale = Math.round(price * (1 - pct / 100));
  document.getElementById('inputSalePrice').value = sale;
  calculateDiscount();
}

function clearDiscount() {
  document.getElementById('inputSalePrice').value = '';
  calculateDiscount();
}

function previewImages(input) {
  const preview = document.getElementById('imagePreview');
  preview.innerHTML = '';
  Array.from(input.files).forEach(file => {
    const reader = new FileReader();
    reader.onload = (e) => {
      const div = document.createElement('div');
      div.className = 'preview-box-item';
      div.innerHTML = `<img src="${e.target.result}" alt="Preview">`;
      preview.appendChild(div);
    };
    reader.readAsDataURL(file);
  });
}

function toggleSidebar() {
  document.getElementById('adminSidebar').classList.toggle('collapsed');
}

document.addEventListener('DOMContentLoaded', () => {
  calculateDiscount();
});
</script>
<script src="/js/main.js"></script>
</body>
</html>