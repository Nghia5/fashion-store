<%
  const formatPrice = (p) => p ? Number(p).toLocaleString('vi-VN') + 'đ' : '0đ';
  const statusMap = {
    pending:   { label: 'Chờ xác nhận', cls: 'status-pending' },
    confirmed: { label: 'Đã xác nhận',  cls: 'status-confirmed' },
    shipping:  { label: 'Đang giao',    cls: 'status-shipping' },
    delivered: { label: 'Đã giao hàng',cls: 'status-delivered' },
    cancelled: { label: 'Đã hủy',       cls: 'status-cancelled' }
  };
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đơn hàng của tôi | Fashion Store</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/shopee.css?v=6">
  <style>
    .orders-page {
      max-width: 1000px; margin: 0 auto;
      padding: 30px 15px 80px;
      padding-top: 40px; margin-top: 10px;
      font-family: 'Inter', sans-serif;
    }
    .orders-breadcrumb {
      font-size: 0.85rem; color: #999; margin-bottom: 24px;
    }
    .orders-breadcrumb a { color: #999; text-decoration: none; }
    .orders-breadcrumb a:hover { color: #d4a574; }
    .orders-breadcrumb i { font-size: 0.65rem; margin: 0 6px; }

    .orders-title {
      font-family: 'Playfair Display', serif; font-size: 2.2rem;
      color: #333; margin-bottom: 24px; text-align: center;
    }

    /* Tabs */
    .orders-tabs {
      display: flex; background: #fff; border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04); margin-bottom: 24px;
      overflow-x: auto;
    }
    .orders-tabs::-webkit-scrollbar { display: none; }
    .tab-item {
      flex: 1; text-align: center; padding: 16px 20px; color: #555;
      font-weight: 500; text-decoration: none; font-size: 0.95rem;
      border-bottom: 3px solid transparent; transition: all 0.2s;
      white-space: nowrap; cursor: pointer;
    }
    .tab-item:hover { color: #d4a574; background: #fef9f4; }
    .tab-item.active { color: #d4a574; border-bottom-color: #d4a574; font-weight: 600; }

    /* Order Card */
    .order-card {
      background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.05);
      margin-bottom: 20px; overflow: hidden;
      animation: fadeIn 0.4s ease;
    }
    .oc-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 16px 24px; border-bottom: 1px solid #f0f0f0; background: #fafafa;
    }
    .oc-header-left { display: flex; align-items: center; gap: 12px; }
    .oc-id { font-weight: 700; color: #333; font-size: 1rem; }
    .oc-date { font-size: 0.85rem; color: #888; }
    .oc-status { font-size: 0.85rem; font-weight: 600; padding: 4px 12px; border-radius: 20px; }
    
    .status-pending { color: #d97706; background: #fef3c7; }
    .status-confirmed { color: #1d4ed8; background: #dbeafe; }
    .status-shipping { color: #4338ca; background: #e0e7ff; }
    .status-delivered { color: #15803d; background: #dcfce7; }
    .status-cancelled { color: #b91c1c; background: #fee2e2; }

    .oc-body { padding: 20px 24px; border-bottom: 1px dashed #f0f0f0; }
    
    /* Product Item in Order Card */
    .oc-item { display: flex; gap: 16px; align-items: center; }
    .oc-item-img {
      width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid #f0f0f0;
    }
    .oc-item-info { flex: 1; }
    .oc-item-name { font-weight: 600; color: #333; font-size: 1rem; margin-bottom: 4px; }
    .oc-item-vars { font-size: 0.85rem; color: #888; margin-bottom: 4px; }
    .oc-item-qty { font-size: 0.85rem; color: #555; }
    
    .oc-item-price { font-weight: 600; color: #d4a574; font-size: 1.05rem; }

    .oc-more-items {
      text-align: center; padding: 12px; font-size: 0.85rem; color: #888;
      background: #fafafa; border-radius: 6px; margin-top: 16px;
    }

    .oc-footer {
      display: flex; justify-content: space-between; align-items: center;
      padding: 20px 24px; background: #fff; flex-wrap: wrap; gap: 16px;
    }
    .oc-total-box { display: flex; align-items: center; gap: 12px; }
    .oc-total-lbl { font-size: 0.95rem; color: #555; }
    .oc-total-val { font-size: 1.4rem; font-weight: 800; color: #d4a574; }
    
    .oc-actions { display: flex; gap: 12px; }
    .btn-action {
      padding: 10px 24px; border-radius: 6px; font-weight: 600; font-size: 0.9rem;
      cursor: pointer; transition: all 0.2s; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
    }
    .btn-detail { background: #fff; border: 1px solid #ddd; color: #555; }
    .btn-detail:hover { border-color: #d4a574; color: #d4a574; background: #fef9f4; }
    .btn-cancel { background: #fff; border: 1px solid #e74c3c; color: #e74c3c; }
    .btn-cancel:hover { background: #e74c3c; color: #fff; }

    .empty-state { text-align: center; padding: 60px 20px; background: #fff; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.05); }
    .empty-state i { font-size: 4rem; color: #ddd; margin-bottom: 16px; display: block; }
    .empty-state h3 { color: #555; margin-bottom: 24px; font-weight: 500; }
    .btn-primary { background: linear-gradient(135deg, #d4a574, #c49565); color: #fff; border: none; box-shadow: 0 4px 12px rgba(212,165,116,0.3); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(212,165,116,0.4); color: #fff; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 640px) {
      .oc-header { flex-direction: column; align-items: flex-start; gap: 12px; }
      .oc-footer { flex-direction: column; align-items: stretch; }
      .oc-total-box { justify-content: space-between; }
      .btn-action { justify-content: center; width: 100%; }
    }
  </style>
</head>
<body>
<% if (success && success.length) { %><div class="flash flash-success"><i class="fas fa-check-circle"></i> <%= success[0] %><button class="flash-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div><% } %>
<% if (error && error.length) { %><div class="flash flash-error"><i class="fas fa-exclamation-circle"></i> <%= error[0] %><button class="flash-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div><% } %>
<%- include('../partials/navbar') %>

<div class="orders-page">
  <!-- Breadcrumb -->
  <div class="orders-breadcrumb">
    <a href="/"><i class="fas fa-home"></i> Trang chủ</a>
    <i class="fas fa-chevron-right"></i>
    <span style="color:#333; font-weight:500;">Đơn hàng của tôi</span>
  </div>

  <h1 class="orders-title">Đơn Hàng Của Tôi</h1>

  <!-- Tabs -->
  <div class="orders-tabs">
    <% const tabs = [['','Tất cả'],['pending','Chờ xác nhận'],['confirmed','Đã xác nhận'],['shipping','Đang giao'],['delivered','Đã giao'],['cancelled','Đã hủy']]; %>
    <% tabs.forEach(([val, label]) => { %>
      <a href="/orders<%= val ? '?status='+val : '' %>" class="tab-item <%= currentStatus === val ? 'active' : '' %>"><%= label %></a>
    <% }); %>
  </div>

  <% if (!orders || orders.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-box-open"></i>
      <h3>Bạn chưa có đơn hàng nào</h3>
      <a href="/products" class="btn-action btn-primary"><i class="fas fa-shopping-bag"></i> Mua sắm ngay</a>
    </div>
  <% } else { %>
    <div class="orders-list">
      <% orders.forEach(order => { %>
        <% const si = statusMap[order.OrderStatus] || { label: order.OrderStatus, cls: 'status-pending' }; %>
        <div class="order-card">
          
          <div class="oc-header">
            <div class="oc-header-left">
              <span class="oc-id">#<%= order.OrderNumber %></span>
              <span class="oc-date"><i class="far fa-calendar-alt"></i> <%= new Date(order.CreatedAt).toLocaleDateString('vi-VN') %></span>
            </div>
            <span class="oc-status <%= si.cls %>"><%= si.label %></span>
          </div>

          <div class="oc-body">
            <% if (order.firstItem) { %>
              <div class="oc-item">
                <img src="<%= order.firstItem.Image || '/images/product-default.jpg' %>" alt="<%= order.firstItem.Name %>" class="oc-item-img">
                <div class="oc-item-info">
                  <div class="oc-item-name"><%= order.firstItem.Name %></div>
                  <div class="oc-item-vars">
                    <% if(order.firstItem.Color || order.firstItem.Size) { %>
                      Phân loại: <%= order.firstItem.Color || '' %><%= (order.firstItem.Color && order.firstItem.Size) ? ' / ' : '' %><%= order.firstItem.Size || '' %>
                    <% } %>
                  </div>
                  <div class="oc-item-qty">x<%= order.firstItem.Quantity %></div>
                </div>
                <div class="oc-item-price"><%= formatPrice(order.firstItem.Price) %></div>
              </div>
            <% } %>

            <% if (order.ItemCount > 1) { %>
              <div class="oc-more-items">
                <i class="fas fa-plus"></i> Xem thêm <%= order.ItemCount - 1 %> sản phẩm khác trong đơn hàng này
              </div>
            <% } %>
          </div>

          <div class="oc-footer">
            <div class="oc-total-box">
              <span class="oc-total-lbl">Tổng thanh toán:</span>
              <span class="oc-total-val"><%= formatPrice(order.TotalPrice) %></span>
            </div>
            
            <div class="oc-actions">
              <% if (order.OrderStatus === 'pending') { %>
                <form action="/orders/<%= order.Id %>/cancel" method="POST" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?')">
                  <button type="submit" class="btn-action btn-cancel"><i class="fas fa-times"></i> Hủy đơn</button>
                </form>
              <% } %>
              <a href="/orders/<%= order.Id %>" class="btn-action btn-detail"><i class="fas fa-file-invoice"></i> Xem chi tiết</a>
            </div>
          </div>
          
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
<button class="scroll-top" id="scrollTop" onclick="window.scrollTo({top:0,behavior:'smooth'})"><i class="fas fa-arrow-up"></i></button>
<script src="/js/main.js"></script>
</body>
</html>
