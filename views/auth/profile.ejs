<%
  const formatPrice = (p) => p ? Number(p).toLocaleString('vi-VN') + 'đ' : '0đ';
  const statusMap = { pending:'Chờ xác nhận', confirmed:'Đã xác nhận', shipping:'Đang giao', delivered:'Đã giao', cancelled:'Đã hủy' };
  const statusCls = { pending:'status-pending', confirmed:'status-confirmed', shipping:'status-shipping', delivered:'status-delivered', cancelled:'status-cancelled' };
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hồ sơ của tôi | Fashion Store</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/shopee.css?v=6">
  <style>
    .profile-page {
      max-width: 1100px; margin: 0 auto;
      padding: 30px 15px 80px;
      padding-top: 40px; margin-top: 10px;
      font-family: 'Inter', sans-serif;
    }
    .profile-breadcrumb {
      font-size: 0.85rem; color: #999; margin-bottom: 24px;
    }
    .profile-breadcrumb a { color: #999; text-decoration: none; }
    .profile-breadcrumb a:hover { color: #d4a574; }
    .profile-breadcrumb i { font-size: 0.65rem; margin: 0 6px; }

    .profile-title {
      font-family: 'Playfair Display', serif; font-size: 2.2rem;
      color: #333; margin-bottom: 24px;
    }

    .profile-layout {
      display: grid; grid-template-columns: 280px 1fr; gap: 24px; align-items: start;
    }

    /* Sidebar */
    .profile-sidebar {
      background: #fff; border-radius: 12px; padding: 24px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.04); text-align: center;
      position: sticky; top: 120px;
    }
    .ps-avatar-wrap {
      width: 90px; height: 90px; border-radius: 50%;
      background: linear-gradient(135deg, #d4a574, #c9926a);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 16px; font-size: 2.4rem; color: #fff;
      box-shadow: 0 4px 12px rgba(212,165,116,0.3); overflow: hidden;
    }
    .ps-avatar-img { width: 100%; height: 100%; object-fit: cover; }
    
    .ps-name { font-size: 1.2rem; font-weight: 700; color: #333; margin-bottom: 4px; }
    .ps-email { font-size: 0.9rem; color: #888; margin-bottom: 12px; }
    .ps-role {
      display: inline-block; background: #f0fdf4; color: #16a34a;
      padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;
      margin-bottom: 24px; border: 1px solid #bbf7d0;
    }
    
    .ps-nav { text-align: left; display: flex; flex-direction: column; gap: 8px; }
    .ps-nav-link {
      display: flex; align-items: center; gap: 12px; padding: 12px 16px;
      border-radius: 8px; font-size: 0.95rem; font-weight: 500; color: #555;
      text-decoration: none; transition: all 0.2s; cursor: pointer; border: none; background: transparent; width: 100%;
    }
    .ps-nav-link i { font-size: 1.1rem; width: 20px; text-align: center; color: #aaa; transition: color 0.2s; }
    .ps-nav-link:hover, .ps-nav-link.active { background: #fef9f4; color: #d4a574; }
    .ps-nav-link:hover i, .ps-nav-link.active i { color: #d4a574; }
    
    .ps-logout {
      margin-top: 16px; color: #e74c3c;
    }
    .ps-logout:hover { background: #fdf2f2; color: #c0392b; }
    .ps-logout i { color: #e74c3c; }

    /* Content Area */
    .profile-content-tab {
      background: #fff; border-radius: 12px; padding: 30px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.04); display: none;
      animation: fadeIn 0.3s ease;
    }
    .profile-content-tab.active { display: block; }
    
    .pc-header {
      font-size: 1.4rem; color: #333; margin-bottom: 24px;
      display: flex; align-items: center; gap: 10px; font-weight: 600;
    }
    .pc-header i { color: #d4a574; }

    /* Forms */
    .pc-form-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;
    }
    .pc-form-group { display: flex; flex-direction: column; gap: 8px; }
    .pc-form-label { font-size: 0.9rem; font-weight: 600; color: #555; }
    .pc-form-label .req { color: #e74c3c; }
    .pc-form-input {
      padding: 12px 16px; border: 1px solid #ddd; border-radius: 8px;
      font-size: 0.95rem; font-family: 'Inter', sans-serif; transition: all 0.2s;
    }
    .pc-form-input:focus { border-color: #d4a574; outline: none; box-shadow: 0 0 0 3px rgba(212,165,116,0.1); }
    .pc-form-input:disabled { background: #f9f9f9; color: #888; cursor: not-allowed; border-color: #eee; }

    .btn-save {
      background: linear-gradient(135deg, #d4a574, #c49565); border: none;
      color: #fff; padding: 12px 28px; border-radius: 8px; font-weight: 600;
      font-size: 0.95rem; cursor: pointer; transition: all 0.2s;
      display: inline-flex; align-items: center; gap: 8px;
      box-shadow: 0 4px 12px rgba(212,165,116,0.3);
    }
    .btn-save:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(212,165,116,0.4); }

    /* Orders Table */
    .pc-table-wrap { overflow-x: auto; margin-bottom: 24px; }
    .pc-table { width: 100%; border-collapse: collapse; min-width: 600px; }
    .pc-table th { padding: 12px 16px; text-align: left; font-size: 0.9rem; color: #888; border-bottom: 2px solid #f0f0f0; }
    .pc-table td { padding: 16px; border-bottom: 1px solid #f5f5f5; vertical-align: middle; }
    .pc-table tbody tr:hover { background: #fafafa; }
    .td-code { font-weight: 600; color: #333; }
    .td-date { color: #888; font-size: 0.9rem; }
    .td-total { font-weight: 600; color: #d4a574; }
    .btn-view {
      padding: 6px 16px; border-radius: 6px; border: 1px solid #ddd;
      color: #555; text-decoration: none; font-size: 0.85rem; transition: all 0.2s; display: inline-block;
    }
    .btn-view:hover { border-color: #d4a574; color: #d4a574; background: #fef9f4; }
    
    .btn-outline-gold {
      padding: 10px 24px; border-radius: 8px; border: 1px solid #d4a574;
      color: #d4a574; text-decoration: none; font-weight: 600; transition: all 0.2s; display: inline-block;
    }
    .btn-outline-gold:hover { background: #d4a574; color: #fff; }

    .empty-orders { text-align: center; padding: 40px 20px; }
    .empty-orders i { font-size: 3.5rem; color: #e0e0e0; margin-bottom: 16px; display: block; }
    .empty-orders p { color: #888; margin-bottom: 24px; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

    @media (max-width: 768px) {
      .profile-layout { grid-template-columns: 1fr; }
      .profile-sidebar { position: static; }
      .pc-form-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<% if (success && success.length) { %><div class="flash flash-success"><i class="fas fa-check-circle"></i> <%= success[0] %><button class="flash-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div><% } %>
<% if (error && error.length) { %><div class="flash flash-error"><i class="fas fa-exclamation-circle"></i> <%= error[0] %><button class="flash-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button></div><% } %>
<%- include('../partials/navbar') %>

<div class="profile-page">
  <!-- Breadcrumb -->
  <div class="profile-breadcrumb">
    <a href="/"><i class="fas fa-home"></i> Trang chủ</a>
    <i class="fas fa-chevron-right"></i>
    <span style="color:#333; font-weight:500;">Hồ sơ của tôi</span>
  </div>

  <h1 class="profile-title">Hồ Sơ Của Tôi</h1>

  <div class="profile-layout">
    <!-- Sidebar -->
    <div class="profile-sidebar">
      <div class="ps-avatar-wrap">
        <% if (profileUser.Avatar) { %>
          <img src="<%= profileUser.Avatar %>" class="ps-avatar-img">
        <% } else { %>
          <i class="fas fa-user"></i>
        <% } %>
      </div>
      <div class="ps-name"><%= profileUser.Name %></div>
      <div class="ps-email"><%= profileUser.Email %></div>
      <div class="ps-role">
        <% if (profileUser.Role === 'admin') { %><i class="fas fa-crown"></i> Quản trị viên<% } else { %><i class="fas fa-user-check"></i> Khách hàng<% } %>
      </div>

      <div class="ps-nav">
        <button class="ps-nav-link active" onclick="switchTab('info', this)"><i class="fas fa-id-card"></i> Thông tin cá nhân</button>
        <button class="ps-nav-link" onclick="switchTab('password', this)"><i class="fas fa-shield-alt"></i> Đổi mật khẩu</button>
        <button class="ps-nav-link" onclick="switchTab('orders', this)"><i class="fas fa-box-open"></i> Đơn hàng gần đây</button>
        <a href="/orders" class="ps-nav-link"><i class="fas fa-list-ul"></i> Tất cả đơn hàng</a>
        <a href="/auth/logout" class="ps-nav-link ps-logout"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
      </div>
    </div>

    <!-- Content -->
    <div class="profile-content">
      <!-- Info Tab -->
      <div id="tab-info" class="profile-content-tab active">
        <div class="pc-header"><i class="fas fa-user-edit"></i> Thông Tin Cá Nhân</div>
        <form action="/auth/profile" method="POST">
          <div class="pc-form-grid">
            <div class="pc-form-group">
              <label class="pc-form-label">Họ và tên <span class="req">*</span></label>
              <input type="text" name="name" class="pc-form-input" value="<%= profileUser.Name %>" required placeholder="Nhập họ và tên">
            </div>
            <div class="pc-form-group">
              <label class="pc-form-label">Số điện thoại</label>
              <input type="tel" name="phone" class="pc-form-input" value="<%= profileUser.Phone || '' %>" placeholder="Ví dụ: 0901234567">
            </div>
            <div class="pc-form-group">
              <label class="pc-form-label">Email</label>
              <input type="email" class="pc-form-input" value="<%= profileUser.Email %>" disabled>
            </div>
            <div class="pc-form-group">
              <label class="pc-form-label">Vai trò tài khoản</label>
              <input type="text" class="pc-form-input" value="<%= profileUser.Role === 'admin' ? 'Quản trị viên' : 'Khách hàng' %>" disabled>
            </div>
          </div>
          <button type="submit" class="btn-save"><i class="fas fa-save"></i> Lưu Thay Đổi</button>
        </form>
      </div>

      <!-- Password Tab -->
      <div id="tab-password" class="profile-content-tab">
        <div class="pc-header"><i class="fas fa-lock"></i> Đổi Mật Khẩu</div>
        <form action="/auth/profile/password" method="POST" style="max-width:400px;">
          <div class="pc-form-group" style="margin-bottom:16px;">
            <label class="pc-form-label">Mật khẩu hiện tại <span class="req">*</span></label>
            <input type="password" name="currentPassword" class="pc-form-input" required placeholder="Nhập mật khẩu cũ">
          </div>
          <div class="pc-form-group" style="margin-bottom:16px;">
            <label class="pc-form-label">Mật khẩu mới <span class="req">*</span></label>
            <input type="password" name="newPassword" class="pc-form-input" required minlength="6" placeholder="Tối thiểu 6 ký tự">
          </div>
          <div class="pc-form-group" style="margin-bottom:24px;">
            <label class="pc-form-label">Xác nhận mật khẩu mới <span class="req">*</span></label>
            <input type="password" name="confirmPassword" class="pc-form-input" required minlength="6" placeholder="Nhập lại mật khẩu mới">
          </div>
          <button type="submit" class="btn-save"><i class="fas fa-key"></i> Cập Nhật Mật Khẩu</button>
        </form>
      </div>

      <!-- Orders Tab -->
      <div id="tab-orders" class="profile-content-tab">
        <div class="pc-header"><i class="fas fa-shopping-bag"></i> Đơn Hàng Gần Đây</div>
        <% if (recentOrders && recentOrders.length > 0) { %>
          <div class="pc-table-wrap">
            <table class="pc-table">
              <thead>
                <tr>
                  <th>Mã đơn hàng</th>
                  <th>Ngày đặt</th>
                  <th>Tổng tiền</th>
                  <th>Trạng thái</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% recentOrders.forEach(order => { %>
                <tr>
                  <td class="td-code">#<%= order.OrderNumber %></td>
                  <td class="td-date"><%= new Date(order.CreatedAt).toLocaleDateString('vi-VN') %></td>
                  <td class="td-total"><%= Number(order.TotalPrice).toLocaleString('vi-VN') %>đ</td>
                  <td><span class="order-status <%= statusCls[order.OrderStatus] || 'status-pending' %>" style="font-size:0.8rem; padding:4px 10px;"><%= statusMap[order.OrderStatus] || order.OrderStatus %></span></td>
                  <td><a href="/orders/<%= order.Id %>" class="btn-view">Xem</a></td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <div><a href="/orders" class="btn-outline-gold">Xem tất cả đơn hàng</a></div>
        <% } else { %>
          <div class="empty-orders">
            <i class="fas fa-box-open"></i>
            <p>Bạn chưa có đơn hàng nào.</p>
            <a href="/products" class="btn-save" style="display:inline-flex;">Mua sắm ngay</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<button class="scroll-top" id="scrollTop" onclick="window.scrollTo({top:0,behavior:'smooth'})"><i class="fas fa-arrow-up"></i></button>

<script>
function switchTab(tabId, btnEl) {
  // Update tabs
  document.querySelectorAll('.profile-content-tab').forEach(tab => {
    tab.classList.remove('active');
  });
  document.getElementById('tab-' + tabId).classList.add('active');
  
  // Update nav buttons
  if(btnEl) {
    document.querySelectorAll('.ps-nav-link').forEach(btn => {
      btn.classList.remove('active');
    });
    btnEl.classList.add('active');
  }
}

// Auto select tab based on hash
window.addEventListener('DOMContentLoaded', () => {
  const hash = window.location.hash.replace('#', '');
  if (['info', 'password', 'orders'].includes(hash)) {
    const btnMap = { 'info': 0, 'password': 1, 'orders': 2 };
    const btns = document.querySelectorAll('.ps-nav-link');
    switchTab(hash, btns[btnMap[hash]]);
  }
});
</script>
<script src="/js/main.js"></script>
</body>
</html>
