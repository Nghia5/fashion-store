<!-- Chatbot -->
<div class="chatbot-container" id="chatbot">
  <button class="chatbot-toggle" id="chatbotToggle"><i class="fas fa-comment-dots"></i></button>
  <div class="chatbot-window" id="chatbotWindow">
    <div class="chatbot-header">
      <div class="chatbot-title"><i class="fas fa-headset"></i> Chăm sóc khách hàng</div>
      <button class="chatbot-close" id="chatbotClose"><i class="fas fa-times"></i></button>
    </div>
    <div class="chatbot-body" id="chatbotBody">
      <div class="chat-msg bot"><p>Xin chào! Fashion Store có thể giúp gì cho bạn hôm nay?</p><div class="chat-suggestions"><button class="chat-chip">Áo nam</button><button class="chat-chip">Tư vấn size</button><button class="chat-chip">Đồ khuyến mãi</button></div></div>
    </div>
    <div class="chatbot-footer">
      <input type="text" id="chatbotInput" placeholder="Nhập tin nhắn..." autocomplete="off">
      <button id="chatbotSend"><i class="fas fa-paper-plane"></i></button>
    </div>
  </div>
</div>




