<%
  const formatPrice = (p) => p ? Number(p).toLocaleString('vi-VN') + 'd' : '0d';
  const getImg = (p) => (p.images && p.images[0]) ? p.images[0] : '/images/product-default.jpg';
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yeu thich | Fashion Store</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<%- include('./partials/navbar') %>
<div class="page-header"><div class="container"><h1>San Pham Yeu Thich</h1></div></div>
<div class="container" style="padding:2rem 1rem;">
  <% if (!products || products.length === 0) { %>
    <div class="empty-cart" style="text-align:center; padding:4rem;">
      <div class="empty-cart-icon"><i class="fas fa-heart"></i></div>
      <h2>Chua co san pham yeu thich</h2>
      <p>Hay kham pha cac san pham cua chung toi!</p>
      <a href="/products" class="btn btn-primary">Kham pha ngay</a>
    </div>
  <% } else { %>
    <div class="products-grid">
      <% products.forEach(product => { %>
      <div class="product-card" data-id="<%= product.Id %>">
        <div class="product-img-wrap">
          <a href="/products/<%= product.slug %>"><img src="<%= getImg(product) %>" alt="<%= product.name %>" class="product-img" loading="lazy"></a>
          <div class="product-actions">
            <button class="action-btn wishlist-btn wishlisted" data-id="<%= product.Id %>" title="Bo yeu thich"><i class="fas fa-heart"></i></button>
            <a href="/products/<%= product.slug %>" class="action-btn" title="Xem chi tiet"><i class="fas fa-eye"></i></a>
            <button class="action-btn add-cart-btn" data-id="<%= product.Id %>" data-color="" data-size="" title="Them vao gio"><i class="fas fa-shopping-bag"></i></button>
          </div>
        </div>
        <div class="product-info">
      <a href="/products/<%= product.slug %>" class="product-name"><%= product.name %></a>
      <div class="product-price">
        <% if (product.salePrice) { %>
          <span class="price-sale"><span style="font-size:0.75rem;text-decoration:underline;">đ</span><%= new Intl.NumberFormat('vi-VN').format(product.salePrice) %></span>
          <span class="price-original">đ<%= new Intl.NumberFormat('vi-VN').format(product.price) %></span>
        <% } else { %>
          <span class="price-sale"><span style="font-size:0.75rem;text-decoration:underline;">đ</span><%= new Intl.NumberFormat('vi-VN').format(product.price) %></span>
        <% } %>
      </div>
      <div class="product-meta-row">
        <div class="product-rating">
          <% for(let i=1; i<=5; i++) { %>
            <i class="fas fa-star <%= i <= Math.round(product.rating) ? 'star-filled' : 'star-empty' %>"></i>
          <% } %>
        </div>
        <div class="sold-count-badge">Đã bán <%= product.Sold || product.sold || 0 %></div>
      </div>
    </div>
      </div>
      <% }); %>
    </div>
  <% } %>
</div>
<%- include('./partials/footer') %>
<button class="scroll-top" id="scrollTop" onclick="window.scrollTo({top:0,behavior:'smooth'})"><i class="fas fa-arrow-up"></i></button>
<script src="/js/main.js"></script>
</body>
</html>

